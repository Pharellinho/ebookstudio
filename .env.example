# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (auth — Google + email/password)
# 1. Create an application at https://dashboard.clerk.com
# 2. Enable Google and Email/Password under User & Authentication
# 3. Paths → Sign-in: /login, Sign-up: /signup
# 4. Allowed redirect URLs: http://localhost:3000/*, https://www.ebookstudioai.com/*, https://ebookstudioai.com/*
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/create
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/create

# Supabase (database + storage — auth is Clerk, not Supabase Auth)
# Apply migrations in order under supabase/migrations/ (through 0005_profiles.sql).
# Without these, the waitlist falls back to local .data/waitlist.json (dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (waitlist confirmation and launch emails)
# 1. Create an API key at https://resend.com/api-keys
# 2. For local tests you can leave FROM empty (uses onboarding@resend.dev)
#    — Resend only delivers that sender to your own Resend account email.
# 3. After ebookstudioai.com is verified in Resend:
#    EbookStudio <hello@ebookstudioai.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=EbookStudio <hello@ebookstudioai.com>

# Required in production — salt for hashing waitlist client IPs
RATE_LIMIT_SALT=

# OpenAI (chapter and outline generation)
OPENAI_API_KEY=

# Stripe (subscriptions and credits)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
